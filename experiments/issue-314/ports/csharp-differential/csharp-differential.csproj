<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Point this at another checkout (for example a worktree of `main`) to
         compare two versions of the parser on the same documents. -->
    <LinksNotationRoot Condition="'$(LinksNotationRoot)' == ''">../../../..</LinksNotationRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(LinksNotationRoot)/csharp/Link.Foundation.Links.Notation/Link.Foundation.Links.Notation.csproj" />
  </ItemGroup>
</Project>
