<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Package metadata -->
    <PackageId>MyPackage</PackageId>
    <Version>0.3.16</Version>
    <Authors>Your Name</Authors>
    <Description>A C# package template for AI-driven development</Description>
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/link-foundation/csharp-ai-driven-development-pipeline-template</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>template;csharp;ai-driven</PackageTags>

    <!-- Documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
