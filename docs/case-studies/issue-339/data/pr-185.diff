diff --git a/csharp/Link.Foundation.Links.Notation.Tests/MultiRefTests.cs b/csharp/Link.Foundation.Links.Notation.Tests/MultiRefTests.cs
new file mode 100644
index 00000000..202603e0
--- /dev/null
