<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- xunit v3 test projects are self-executing: each one builds into its own
         test host, so it has to be an Exe rather than a library. -->
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Link.Foundation.Links.Notation.Tests</RootNamespace>
    <NoWarn>$(NoWarn);CS8981;CS1591;CS1584;CS1658</NoWarn>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- Microsoft.NET.Test.Sdk, xunit.runner.visualstudio and coverlet.collector
         are all VSTest components; under Microsoft.Testing.Platform xunit.v3
         provides the runner and none of them are used. -->
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="Microsoft.ApplicationInsights" Version="3.2.0" PrivateAssets="all" />
    <!-- NuGet otherwise resolves xUnit's minimum transitive runner versions. -->
    <PackageReference Include="Microsoft.Testing.Extensions.Telemetry" Version="2.5.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport.Abstractions" Version="2.5.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Testing.Platform" Version="2.5.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Testing.Platform.MSBuild" Version="2.5.3" PrivateAssets="all" />
    <PackageReference Include="Azure.Core" Version="1.65.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="11.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="11.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging.Configuration" Version="11.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.92.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.92.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.IdentityModel.Abstractions" Version="8.23.0" PrivateAssets="all" />
    <PackageReference Include="OpenTelemetry" Version="1.21.0" PrivateAssets="all" />
    <PackageReference Include="OpenTelemetry.Api" Version="1.21.0" PrivateAssets="all" />
    <PackageReference Include="OpenTelemetry.Api.ProviderBuilderExtensions" Version="1.21.0" PrivateAssets="all" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" PrivateAssets="all" />
    <PackageReference Include="OpenTelemetry.PersistentStorage.Abstractions" Version="1.2.0" PrivateAssets="all" />
    <PackageReference Include="OpenTelemetry.PersistentStorage.FileSystem" Version="1.2.0" PrivateAssets="all" />
    <PackageReference Include="System.ClientModel" Version="1.17.0" PrivateAssets="all" />
    <PackageReference Include="System.Memory.Data" Version="11.0.0" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="11.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Link.Foundation.Links.Notation\Link.Foundation.Links.Notation.csproj" />
    <None Include="../../parity/nested-fixtures.json" Link="Protocol/nested-fixtures.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../parity/text-fixtures.json" Link="Protocol/text-fixtures.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../parity/syntax-fixtures.json" Link="Protocol/syntax-fixtures.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/protocol/binary-links-notation-vectors.txt" Link="Protocol/binary-links-notation-vectors.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/protocol/invalid-reference-literals.txt" Link="Protocol/invalid-reference-literals.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/protocol/reference-literals.txt" Link="Protocol/reference-literals.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
