<?xml version="1.0" encoding="UTF-8"?>
<root>
  <service>
    <name>links-notation-gateway</name>
    <version>0.17.0</version>
    <runtime>
      <workers>6</workers>
      <limits>
        <memoryMb>806</memoryMb>
        <cpuMillis>3746</cpuMillis>
        <requests>
          <perMinute>3600</perMinute>
          <burst>185</burst>
          <shed>
            <enabled>true</enabled>
            <strategy>oldest-first</strategy>
            <thresholds>
              <queueDepth>382</queueDepth>
              <latencyMs>1408</latencyMs>
            </thresholds>
          </shed>
        </requests>
      </limits>
    </runtime>
    <storage>
      <driver>postgres</driver>
      <endpoint>
        <host>db.internal.example.com</host>
        <port>5432</port>
        <tls>
          <enabled>true</enabled>
          <minVersion>1.3</minVersion>
          <verify>
            <hostname>true</hostname>
            <chain>true</chain>
          </verify>
        </tls>
      </endpoint>
      <pool>
        <min>3</min>
        <max>46</max>
        <idleSeconds>150</idleSeconds>
      </pool>
    </storage>
    <telemetry>
      <logs>
        <level>info</level>
        <format>json</format>
        <sampleRate>0.17</sampleRate>
      </logs>
      <traces>
        <enabled>true</enabled>
        <sampleRate>0.65</sampleRate>
      </traces>
      <metrics>
        <enabled>true</enabled>
        <intervalSeconds>51</intervalSeconds>
      </metrics>
    </telemetry>
  </service>
</root>
