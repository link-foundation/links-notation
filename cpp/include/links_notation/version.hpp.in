#ifndef LINKS_NOTATION_VERSION_HPP
#define LINKS_NOTATION_VERSION_HPP

// clang-format off: CMake replaces the @-delimited placeholders.
#define LINKS_NOTATION_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define LINKS_NOTATION_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define LINKS_NOTATION_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define LINKS_NOTATION_VERSION_STRING "@PROJECT_VERSION@"
// clang-format on

namespace links_notation {

/// The library version, read from cpp/VERSION when the build is configured.
inline constexpr const char* version = LINKS_NOTATION_VERSION_STRING;

}  // namespace links_notation

#endif  // LINKS_NOTATION_VERSION_HPP
