{
    "name": "link-foundation/links-notation",
    "description": "Links Notation (lino) parser and formatter for PHP",
    "type": "library",
    "keywords": ["links", "notation", "lino", "parser", "formatter", "links-platform"],
    "homepage": "https://github.com/link-foundation/links-notation",
    "license": "Unlicense",
    "version": "0.16.1",
    "authors": [
        {
            "name": "Link Foundation",
            "homepage": "https://github.com/link-foundation"
        }
    ],
    "support": {
        "issues": "https://github.com/link-foundation/links-notation/issues",
        "source": "https://github.com/link-foundation/links-notation"
    },
    "require": {
        "php": ">=8.4",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "LinkFoundation\\LinksNotation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LinkFoundation\\LinksNotation\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "lint:fix": "phpcbf"
    },
    "config": {
        "sort-packages": true
    }
}
