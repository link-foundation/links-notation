<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="links-notation">
    <description>PSR-12 coding standard for the PHP implementation of Links Notation.</description>

    <file>src</file>
    <file>tests</file>

    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>

    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="120"/>
        </properties>
    </rule>
</ruleset>
